# Copy this file to .env and change the values. Never commit .env.

# Required: a long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# First admin account (created by the seed script on startup)
# Use a normal domain: reserved ones such as .local or .test are rejected at login.
ADMIN_EMAIL=admin@snapclass.dev
ADMIN_PASSWORD=change-me-admin-password

# Postgres password used by docker compose
POSTGRES_PASSWORD=snapclass

# Where students open join links (the React app)
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Delete enrollment photos/audio right after embeddings are made (FR-A7)
DELETE_ENROLLMENT_MEDIA=true

# Optional: weekly email. Leave SMTP_HOST empty to only log the email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=snapclass@localhost
